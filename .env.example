# ---- Azure AI Foundry ----
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_OPENAI_API_KEY=your-azure-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_CHAT_DEPLOYMENT=gpt-4.1-mini
AZURE_EMBED_DEPLOYMENT=text-embedding-3-small

# ---- Cheap bulk provider (Groq, OpenAI-compatible) ----
CHEAP_API_KEY=your-groq-key
CHEAP_BASE_URL=https://api.groq.com/openai/v1
CHEAP_MODEL=openai/gpt-oss-20b

# ---- Apify (live prospect discovery) ----
APIFY_TOKEN=your-apify-token

# ---- Foundry project endpoint (agents SDK; optional) ----
AZURE_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT

# ---- Gmail OAuth (send from the connected account) ----
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ---- Serper (fast Google search for discovery; optional, recommended) ----
SERPER_API_KEY=your-serper-key
